class Solution {
    int countFreq(int[] arr, int target) {
        // code here
        var lowerBound = Integer.MAX_VALUE;
        var upperBound = Integer.MIN_VALUE;
        var start = 0;
        var end = arr.length - 1;
        
        while(start <= end){
            int mid = (end - start)/2 + start;
            if(arr[mid] == target){
                if(lowerBound > mid){
                    lowerBound = mid;
                }
                end = mid - 1;
            }else if(arr[mid] < target){
                start = mid + 1;
            }else if(arr[mid] > target){
                end = mid - 1;
            }
        }
        
        start = 0;
        end = arr.length - 1;
        
        while(start <= end){
            int mid = (end - start)/2 + start;
            if(arr[mid] == target){
                if(upperBound < mid){
                    upperBound = mid;
                }
                start = mid + 1;
            }else if(arr[mid] < target){
                start = mid + 1;
            }else if(arr[mid] > target){
                end = mid - 1;
            }
        }
        
        if(lowerBound == Integer.MAX_VALUE && upperBound == Integer.MIN_VALUE){
            return 0;
        }
        
        return upperBound-lowerBound+1;
    }
}
