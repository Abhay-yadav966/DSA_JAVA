class Solution {
    public boolean searchMatrix(int[][] mat, int x) {
        // code here
        for(var i = 0; i < mat.length; i++){
            for(var j = 0; j < mat[0].length; j++){
                if(mat[i][j] == x){
                    return true;
                }
            }
        }
        return false;
    }
}
