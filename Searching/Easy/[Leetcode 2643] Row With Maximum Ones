class Solution {
    public int[] rowAndMaximumOnes(int[][] mat) {
        var ans = new int[2];
        var ansRow = -1;
        var ansCount = Integer.MIN_VALUE;

        for(var i = 0; i < mat.length; i++){
            var count = 0;
            for(var j = 0; j < mat[0].length; j++){
                if(mat[i][j] == 1){
                    count++;
                }
            }
            if(count > ansCount){
                ansCount = count;
                ansRow = i;
            }
        }
        ans[0] = ansRow;
        ans[1] = ansCount;
        return ans;
    }
}
