class Solution {
    public boolean binarySearch(int[] arr, int k) {
        // code here
        var start = 0;
        var end = arr.length - 1;
        while(start <= end){
            var mid = (end - start)/2 + start;
            if(arr[mid] == k){
                return true;
            }else if(arr[mid] > k){
                end = mid - 1;
            }else if(arr[mid] < k){
                start = mid + 1;
            }
        }
        return false;
    }
}
