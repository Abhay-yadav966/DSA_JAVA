class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        var totalRow = matrix.length;
        var totalCol = matrix[0].length;

        var row = 0;
        var col = totalCol-1;

        while(row < totalRow && col >= 0){
            if(matrix[row][col] == target){
                return true;
            }else if(matrix[row][col] < target){
                row++;
            }else if(matrix[row][col] > target){
                col--;
            }
        }
        return false;
    }
}
