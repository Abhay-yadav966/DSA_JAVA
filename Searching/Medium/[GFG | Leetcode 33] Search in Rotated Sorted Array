class Solution {
    public int search(int[] nums, int target) {
        var start = 0;
        var end = nums.length - 1;
        var pivotIndex = -1;
        
        while(start <= end){
            var mid = (end-start)/2+start;
            if(nums[mid] > nums[nums.length-1]){
                pivotIndex = mid;
                start = mid + 1;
            }else{
                end = mid - 1;
            }
        }
        
        if(target <= nums[nums.length-1]){
            start = pivotIndex+1;
            end = nums.length-1;
        }else{
            start = 0;
            end = pivotIndex;
        }
        
        while(start<=end){
            var mid = (end-start)/2+start;
            if(nums[mid] == target){
                return mid;
            }else if(nums[mid] > target){
                end = mid-1;
            }else if(nums[mid] < target){
                start = mid+1;
            }
        }
        return -1;
    }
}
