class Solution {
    public static ArrayList<Integer> findUnion(int a[], int b[]) {
        // code here
        int i = 0;
        int j = 0;
        int size1 = a.length;
        int size2 = b.length;
        ArrayList<Integer> ans = new ArrayList<>();
        
        while(i < size1 && j < size2){
            if(a[i] == b[j]){
                if(ans.isEmpty() ||  (!ans.isEmpty() && ans.get(ans.size()-1) != a[i]) ){
                    ans.add(a[i]);
                }
                i++;
                j++;
            }else if(a[i] < b[j]){
                if(ans.isEmpty() ||  (!ans.isEmpty() && ans.get(ans.size()-1) != a[i]) ){
                    ans.add(a[i]);
                }
                i++;
            }else if(b[j] < a[i]){
                if(ans.isEmpty() || (!ans.isEmpty() && ans.get(ans.size()-1) != b[j]) ){
                    ans.add(b[j]);
                }
                j++;
            }
        }
        
        while(i < size1){
            if(!ans.isEmpty() && ans.get(ans.size()-1) != a[i]){
                ans.add(a[i]);
            }
            i++;
        }
        
        while(j < size2){
            if(!ans.isEmpty() && ans.get(ans.size()-1) != b[j]){
                ans.add(b[j]);
            }
            j++;
        }
        
        return ans;
    }
}
