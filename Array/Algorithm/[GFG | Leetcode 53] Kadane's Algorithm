class Solution {
    public int maxSubArray(int[] nums) {
        if(nums.length == 1){
            return nums[0];
        }

        int sum = 0;
        int maxi = Integer.MIN_VALUE;

        for(var val:nums){
            sum = sum + val;

            if(sum > maxi){
                maxi = sum;
            }
            
            if(sum < 0){
                sum = 0;
            }

        }

        return maxi;
    }
}
