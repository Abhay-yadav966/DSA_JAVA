class Solution {
    public int findDiff(int[] arr) {
        // code here
        HashMap<Integer, Integer> map = new HashMap<>();
        int mini = Integer.MAX_VALUE;
        int maxi = Integer.MIN_VALUE;
        for(var val:arr){
            map.put(val, map.getOrDefault(val, 0)+1);
        }
        
        for(var key:map.keySet()){
            int val = map.get(key);
            if(val < mini){
                mini = val;
            }
            if(val > maxi){
                maxi = val;
            }
        }
        
        return maxi-mini;
    }
}
