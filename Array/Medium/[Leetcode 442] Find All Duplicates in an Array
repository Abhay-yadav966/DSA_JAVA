class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        List<Integer> ans = new ArrayList<>();
        for(var i = 0; i < nums.length; i++){
            var idx = Math.abs(nums[i]) - 1;
            if(nums[idx] < 0){
                ans.add(idx+1);
            }else{
                nums[idx] = nums[idx] * -1;
            }
        }
        return ans;
    }
}
