class Solution {
    public void rotate(int[] arr) {
        // code here
        int start = 0;
        int end = arr.length - 1;
        
        while(start <= end){
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;
            start++;
            end--;
        }
        
        if(arr.length > 1){
            start = 1;
            end = arr.length - 1;
            
            while(start <= end){
                int temp = arr[start];
                arr[start] = arr[end];
                arr[end] = temp;
                start++;
                end--;
            }
        }
    }
}
