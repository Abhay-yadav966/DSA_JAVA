class Solution {
    public int firstRepeated(int[] arr) {
        // code here
        HashMap<Integer, Integer> map = new HashMap<>();
        for(var val:arr){
            map.put(val, map.getOrDefault(val, 0) + 1);
        }
        
        for(int i = 0; i < arr.length; i++){
            if(map.get(arr[i]) > 1){
                return i+1;
            }
        }
        
        return -1;
    }
}
