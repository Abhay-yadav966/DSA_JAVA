class Solution {
    boolean twoSum(int arr[], int target) {
        // code here
        Arrays.sort(arr);
        int start = 0;
        int end = arr.length - 1;
        while(start < end){
            int sum = arr[start] + arr[end];
            if(sum == target){
                return true;
            }else if(sum > target){
                end--;
            }else if(sum < target){
                start++;
            }
        }
        return false;
    }
}
