class Solution {
    public static int[] rowSum(int mat[][]) {
        // Code here
        int[] ans = new int[mat.length];
        for(var row = 0; row < mat.length; row++){
            var sum = 0;
            for(var col = 0; col < mat[row].length; col++){
                sum = sum + mat[row][col];
            }
            ans[row] = sum;
        }
        return ans;
    }
}
