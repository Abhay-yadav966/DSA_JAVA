class Solution {
    public int[][] transpose(int[][] matrix) {
        int[][] ans = new int[matrix[0].length][matrix.length];
        for(var i = 0; i < matrix[0].length; i++){
            int[] temp = new int[matrix.length];
            for(var j = 0; j < matrix.length; j++){
                temp[j] = matrix[j][i];
            }
            ans[i] = temp;
        }
        return ans;
    }
}
