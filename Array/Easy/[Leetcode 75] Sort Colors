class Solution {
    public void sortColors(int[] nums) {
        int idx = 0;
        int start = 0;
        int end = nums.length - 1;

        while(idx <= end){
            if(nums[idx] == 2){
                int temp = nums[idx];
                nums[idx] = nums[end];
                nums[end] = temp;
                end--;
            }else if(nums[idx] == 0){
                int temp = nums[idx];
                nums[idx] = nums[start];
                nums[start] = temp;
                start++;
                idx++;
            }else if(nums[idx] == 1){
                idx++;
            }
        }
    }
}
