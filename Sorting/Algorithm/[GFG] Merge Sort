class Solution {
    private void merge(int[] arr, int start, int end) {
        var mid = start + (end-start)/2;
        
        var size1 = mid-start+1;
        var size2 = end-mid;
        
        var arr1 = new int[size1];
        var arr2 = new int[size2];
        
        var idx = start;
        
        for(var i=0; i < size1; i++) {
            arr1[i] = arr[idx];
            idx++;
        }
        
        idx = mid+1;
        
        for(var i=0; i < size2; i++) {
            arr2[i] = arr[idx];
            idx++;
        }
        
        idx=start;
        var i = 0;
        var j = 0;
        
        while(i < size1 && j < size2) {
            if(arr1[i] < arr2[j]) {
                arr[idx] = arr1[i];
                i++;
                idx++;
            }else {
                arr[idx] = arr2[j];
                j++;
                idx++;
            }
        }
        
        while(i < size1) {
            arr[idx] = arr1[i];
            i++;
            idx++;
        }
        
        while(j < size2) {
            arr[idx] = arr2[j];
            j++;
            idx++;
        }
    }
    
    public void mergeSort(int arr[], int l, int r) {
        if(l >= r) {
            return;
        }
        
        // code here
        var mid = l + (r-l)/2;
        
        //left
        mergeSort(arr, l, mid);
        
        //right
        mergeSort(arr, mid+1, r);
        
        //merge
        merge(arr, l, r);
    }
}
