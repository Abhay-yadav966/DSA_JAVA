class Solution {
    private void helper(int[] nums, int[] ans, int sum, int idx){
        if(idx >= nums.length){
            if(sum > ans[0]){
                ans[0] = sum;
            }
            return;
        }

        //include
        sum = sum + nums[idx];
        helper(nums, ans, sum, idx+2);
        sum = sum - nums[idx];

        //exclude
        helper(nums, ans, sum, idx+1);
    }

    public int rob(int[] nums) {
        int[] ans = {Integer.MIN_VALUE};
        var sum = 0;
        var idx = 0;

        helper(nums, ans, sum, idx);
        return ans[0];
    }
}
