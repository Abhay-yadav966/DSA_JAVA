class Solution {
    private void solve(String digits, HashMap<Character, String> map, int idx, StringBuilder temp, List<String> ans) {
        if(temp.length() == digits.length()) {
            ans.add(temp.toString());
            return;
        }

        if(idx >= digits.length()) {
            return;
        }

        String str = map.get(digits.charAt(idx));
        for(var i = 0; i < str.length(); i++) {
            temp.append(str.charAt(i));
            solve(digits, map, idx+1, temp, ans);
            temp.deleteCharAt(temp.length()-1);
        }
    }

    public List<String> letterCombinations(String digits) {
        HashMap<Character, String> map = new HashMap<>();
        map.put('2', "abc");
        map.put('3', "def");
        map.put('4', "ghi");
        map.put('5', "jkl");
        map.put('6', "mno");
        map.put('7', "pqrs");
        map.put('8', "tuv");
        map.put('9', "wxyz");

        var idx = 0;
        StringBuilder temp = new StringBuilder();
        List<String> ans = new ArrayList<>();

        solve(digits, map, idx, temp, ans);
        return ans;
    }
}
