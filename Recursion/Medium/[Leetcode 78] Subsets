class Solution {
    private void solve(int[] nums, List<List<Integer>> ans, List<Integer> list, int idx) {
        if(idx >= nums.length) {
            ans.add(new ArrayList(list));
            return;
        }

        //include
        list.add(nums[idx]);
        solve(nums, ans, list, idx+1);
        list.remove(list.size()-1);

        //exclude
        solve(nums, ans, list, idx+1);
    }

    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> list = new ArrayList<>();
        var idx = 0;

        solve(nums, ans, list, idx);

        return ans;
    }
}
