class Solution {
    private boolean isSafe(char[][] board, int row, int col){
        var i = row;
        var j = col;

        // back
        for(var k = 0; k <= j; k++ ) {
            if(board[i][k] == 'Q') {
                return false;
            }
        }

        //upward
        i = row;
        j = col;

        while(i >= 0 && j >= 0) {
            if(board[i][j] == 'Q') {
                return false;
            }
            i--;
            j--;
        }

        //downward
        i = row;
        j = col;

        while(i < board.length && j >= 0) {
            if(board[i][j] == 'Q') {
                return false;
            }
            i++;
            j--;
        }

        return true;
    }

    private void solve(char[][] board, int idx, List<List<String>> ans) {
        if(idx >= board.length) {
            List<String> temp = new ArrayList<>();
            for(var i = 0; i < board.length; i++) {
                temp.add(new String(board[i]));
            }
            ans.add(temp);
            return;
        }

        for(var row = 0; row < board.length; row++){
            if(isSafe(board, row, idx)) {
                board[row][idx] = 'Q';
                solve(board, idx+1, ans);
                board[row][idx] = '.';
            }
        }
    }

    public List<List<String>> solveNQueens(int n) {
        char[][] board = new char[n][n];
        for(var i = 0; i < n; i++){
            Arrays.fill(board[i], '.');
        }
        var idx = 0;
        List<List<String>> ans = new ArrayList();
        solve(board, idx, ans);
        return ans;
    }
}
