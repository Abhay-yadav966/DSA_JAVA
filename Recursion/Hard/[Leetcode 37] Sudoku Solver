class Solution {

    private boolean isSafe(char[][] board, int row, int col, int val) {
        val = (char)(val+'0');
        //row check
        for(var i = 0; i < board[0].length; i++) {
            if(board[row][i] == val) {
                return false;
            }
        }

        //col check
        for(var i=0; i < board.length; i++) {
            if(board[i][col] == val) {
                return false;
            }
        }

        //matrix check
        var rowStart = row - row%3;
        var colStart = col - col%3;

        for(var i = 0; i < 3; i++) {
            for(var j = 0; j < 3; j++) {
                var actualRow = rowStart+i;
                var actualCol = colStart+j;
                if(board[actualRow][actualCol] == val) {
                    return false;
                }
            }
        }

        return true;
    }

    private boolean solve(char[][] board) {

        for(var row=0; row < board.length; row++) {
            for(var col=0; col < board[0].length; col++) {
                if(board[row][col] == '.') {
                    for(var val=1; val <= 9; val++) {
                        if(isSafe(board, row, col, val)) {
                            board[row][col] = (char)(val+'0');
                            boolean result = solve(board);
                            if(result == true) {
                                return true;
                            }
                            board[row][col] = '.';
                        }
                    }
                    return false;
                }
            }
        }
        return true;
    }

    public void solveSudoku(char[][] board) {
        solve(board);
    }
}
