/* Structure of Linked List Node
class Node
{
  int data;
  Node next;
  Node(int data)
  {
      this.data = data;
      this.next = null;
  }
}*/

class Solution {
    static void linkDelete(Node head, int n, int m) {
        // code here
        Node temp = head;
        while(temp != null) {
            for(var i=1; i < m; i++) {
                if(temp != null) {
                    temp = temp.next;
                }
            }
            
            Node skipNode = null;
            if(temp != null) {
                skipNode = temp.next;
            }
            
            for(var i=1; i <= n; i++) {
                if(skipNode != null) {
                    skipNode = skipNode.next;
                }
            }
            
            if(temp != null) {
                temp.next = skipNode;
                temp = temp.next;
            }
        }
    }
}
