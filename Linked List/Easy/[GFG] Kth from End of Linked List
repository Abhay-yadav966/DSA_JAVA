/* Structure of Linked List Node
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
} */

class Solution {
    public int getKthFromLast(Node head, int k) {
        // code here
        Node curr = head;
        Node prev = head;
        
        for(var i=1; i <= k; i++) {
            if(curr != null) {
                curr = curr.next;
            }else {
                return -1;
            }
        }
        
        while(curr != null) {
            curr = curr.next;
            prev = prev.next;
        }
        
        return prev.data;
    }
}
