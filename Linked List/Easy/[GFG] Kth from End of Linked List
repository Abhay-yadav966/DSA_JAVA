/* Structure of Linked List Node
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
} */

class Solution {
    private Node reverse(Node head) {
        Node prev = null;
        Node curr = head;
        Node forward = head;
        
        while(forward != null) {
            forward = forward.next;
            curr.next = prev;
            prev = curr;
            curr = forward;
        }
        return prev;
    }
    
    public int getKthFromLast(Node head, int k) {
        // code here
        head = reverse(head);
        for(var i=1; i < k; i++) {
            if(head != null) {
                head = head.next;
            }else {
                return -1;
            }
        }
        
        if(head == null) {
            return -1;
        }
        
        return head.data;
    }
}
