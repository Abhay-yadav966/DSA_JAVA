/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    private int size(ListNode head) {
        ListNode temp = head;
        var count = 0;
        while(temp != null) {
            count++;
            temp = temp.next;
        }
        return count;
    }

    public ListNode getIntersectionNode(ListNode headA, ListNode headB) {
        var size1 = size(headA);
        var size2 = size(headB);

        var diff = Math.abs(size1 - size2);

        if(size1 > size2) {
            while(diff > 0) {
                headA = headA.next;
                diff--;
            }
        }else {
            while(diff > 0) {
                headB = headB.next;
                diff--;
            }
        }

        while(headA != null && headB != null) {
            if(headA == headB) {
                return headA;
            }
            headA = headA.next;
            headB = headB.next;
        }
        return null;
    }
}
