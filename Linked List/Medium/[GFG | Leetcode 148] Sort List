/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */
class Solution {
    private ListNode findMid(ListNode head) {
        ListNode slow = head;
        ListNode fast = head.next;

        while(fast != null) {
            fast = fast.next;
            if(fast != null) {
                slow = slow.next;
                fast = fast.next;
            }
        }
        return slow;
    }

    private ListNode merge(ListNode leftList, ListNode rightList) {
        ListNode ansHead = null;
        ListNode ansTail = null;

        while(leftList != null && rightList != null) {
            if(ansHead == null && ansTail == null) {
                if(leftList.val < rightList.val) {
                    ansHead = leftList;
                    ansTail = leftList;
                    leftList = leftList.next;
                }else {
                    ansHead = rightList;
                    ansTail = rightList;
                    rightList = rightList.next;
                }
            }else {
                if(leftList.val < rightList.val) {
                    ansTail.next = leftList;
                    ansTail = ansTail.next;
                    leftList = leftList.next;
                }else {
                    ansTail.next = rightList;
                    ansTail = ansTail.next;
                    rightList = rightList.next;
                }
            }
        }

        while(leftList != null) {
            ansTail.next = leftList;
            ansTail = ansTail.next;
            leftList = leftList.next;
        }

        while(rightList != null) {
            ansTail.next = rightList;
            ansTail = ansTail.next;
            rightList = rightList.next;
        }

        return ansHead;
    }

    public ListNode sortList(ListNode head) {
        if(head == null || head.next == null) {
            return head;
        }

        ListNode mid = findMid(head);

        ListNode leftPart = head;
        ListNode rightPart = mid.next;
        mid.next = null;

        ListNode leftList = sortList(leftPart);
        ListNode rightList = sortList(rightPart);

        return merge(leftList, rightList);
    }
}
