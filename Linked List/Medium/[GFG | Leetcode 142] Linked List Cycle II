/**
 * Definition for singly-linked list.
 * class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public ListNode detectCycle(ListNode head) {
        if(head == null || head.next == null) {
            return null;
        }

        ListNode slow = head;
        ListNode fast = head;

        while(slow != null && fast != null) {
            slow = slow.next;
            fast = fast.next;
            if(fast != null) {
                fast = fast.next;
            }

            if(slow == fast) {
                slow = head;
                break;
            }
        }

        if(fast == null) {
            return null;
        }

        if(slow == fast) {
            return slow;
        }

        while(slow != fast) {
            slow = slow.next;
            fast = fast.next;
            if(slow == fast) {
                return slow;
            }
        }
        return null;
    }
}
