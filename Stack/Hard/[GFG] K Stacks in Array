class kStacks {

    // main array to store elements
    private int[] arr;
    private int[] next;
    private int[] top;
    private int free = 0;

    public kStacks(int n, int k) {
        // initialize data structures for k stacks
        this.arr = new int[n];
        this.next = new int[n];
        this.top = new int[k];
        
        for (var i = 0; i < k; i++) {
            top[i] = -1;
        }
        
        for (var i = 0; i < n; i++) {
            next[i] = i+1;
        }
        next[n-1] = -1;
        
    }

    public void push(int x, int i) {
        // push element x into stack i
        if (free != -1) {
            var idx = free;
            free = next[free];
            arr[idx] = x;
            next[idx] = top[i];
            top[i] = idx;
        }
    }

    public int pop(int i) {
        // pop element from stack i
        if (top[i] == -1) {
            return -1;
        }
        
        var topIdx = top[i];
        var topEle = arr[topIdx];
        top[i] = next[topIdx];
        next[topIdx] = free;
        free = topIdx;
        
        return topEle;
    }
}
