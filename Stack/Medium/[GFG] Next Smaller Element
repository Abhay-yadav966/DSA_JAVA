class Solution {
    static ArrayList<Integer> nextSmallerEle(int[] arr) {
        // code here
        ArrayList<Integer> ans = new ArrayList<>();
        Deque<Integer> stack = new ArrayDeque<>();
        stack.push(-1);
        
        for (var i = arr.length-1; i >= 0; i--) {
            if (arr[i] > stack.peek()) {
                ans.add(0, stack.peek());
            } else {
                while (arr[i] <= stack.peek()) {
                    stack.pop();
                }
                
                ans.add(0, stack.peek());
            }
            stack.push(arr[i]);
        }
        
        return ans;
    }
}
