class Solution {
    public int countMinReversals(String s) {
        // code here
        if(s.length()%2 != 0) {
            return -1;
        }
        
        Deque<Character> stack = new ArrayDeque<>();
        
        for(var i = 0; i < s.length(); i++) {
            if(stack.isEmpty()) {
                stack.push(s.charAt(i));
            } else if(s.charAt(i) == '}' && stack.peek() == '{') {
                stack.pop();
            } else {
                stack.push(s.charAt(i));
            }
        }
        
        var openBrac = 0;
        var closeBrac = 0;
        
        while(!stack.isEmpty()) {
            if(stack.peek() == '}') {
                closeBrac++;
            } else {
                openBrac++;
            }
            stack.pop();
        }
        
        return (openBrac+1)/2 + (closeBrac+1)/2;
    }
}
