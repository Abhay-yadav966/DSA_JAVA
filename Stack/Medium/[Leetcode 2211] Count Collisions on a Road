class Solution {
    public int countCollisions(String directions) {
        var ans = 0;
        Deque<Character> stack = new ArrayDeque<>();
        var s = 0;
        var e = directions.length() - 1;

        while (s <= e) {
            if (directions.charAt(s) == 'L')
            {
                s++;
            } else {
                break;   
            }
        }

        while (e >= s) {
            if (directions.charAt(e) == 'R') {
                e--;
            } else {
                break;
            }
        }

        for (var i = s; i <= e; i++) {
            if (stack.isEmpty()) {
                stack.push(directions.charAt(i));
            } else {
                var top = stack.peek();
                if (top == 'R' && 'L' == directions.charAt(i) ) {
                    ans = ans + 2;
                    stack.pop();
                    while (!stack.isEmpty() && stack.peek() == 'R') {
                        ans = ans + 1;
                        stack.pop();
                    }
                    stack.push('S');
                } else if ((top == 'R' && directions.charAt(i) == 'S') || (top == 'S' && directions.charAt(i) == 'L') ) {
                    ans = ans + 1;
                    stack.pop();
                    while (!stack.isEmpty() && stack.peek() == 'R') {
                        ans = ans + 1;
                        stack.pop();
                    }
                    stack.push('S');
                } else {
                    stack.push(directions.charAt(i));
                }
            } 
        }

        return ans;
    }
}
