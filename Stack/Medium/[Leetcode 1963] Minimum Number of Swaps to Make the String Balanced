class Solution {
    public int minSwaps(String s) {
        Deque<Character> stack = new ArrayDeque<>();
        for(var i=0; i < s.length(); i++) {
            if(!stack.isEmpty() && s.charAt(i) == ']' && stack.peek() == '[') {
                stack.pop();
            } else {
                stack.push(s.charAt(i));
            }
        }

        var openNum = 0;
        while(!stack.isEmpty()) {
            if(stack.peek() == '[') {
                openNum++;
            }
            stack.pop();
        }

        return (openNum+1)/2;
    }
}
