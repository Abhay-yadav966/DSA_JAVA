class myStack {

    Node head = null;
    Node temp = null;
    int size = 0;

    public myStack() {
        // Initialize your data members
    }

    public boolean isEmpty() {
        // check if the stack is empty
        if (head == null && temp == null) {
            return true;
        }
        return false;
    }

    public void push(int x) {
        // Adds an element x at the rear of the stack.
        Node newNode = new Node(x);
        if (head == null) {
            head = newNode;
            temp = newNode;
        } else {
            temp.next = newNode;
            temp = newNode;
        }
        size++;
    }

    public void pop() {
        // Removes the front element of the stack.
        Node trav = head;
        while (trav != null) {
            if (trav.next == null) {
                temp = null;
                head = null;
                size--;
            } else if (trav.next != null && trav.next.next == null) {
                trav.next = null;
                temp = trav;
                size--;
            }
            trav = trav.next;
        }
    }

    public int peek() {
        // Returns the front element of the stack.
        // If stack is empty, return -1.
        if (head == null && temp == null) {
            return -1;
        }
        
        return temp.data;
    }

    public int size() {
        // Returns the current size of the stack.
        return size;
    }
}
