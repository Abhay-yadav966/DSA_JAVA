class Solution {
    public boolean isValid(String s) {
        Deque<Character> stack = new ArrayDeque<>();
        for(var i = 0; i < s.length(); i++) {
            if(stack.isEmpty()) {
                stack.push(s.charAt(i));
            }else {
                if(')' == s.charAt(i) && '(' == stack.peek()) {
                    stack.pop();
                } else if('}' == s.charAt(i) && '{' == stack.peek()) {
                    stack.pop();
                } else if(']' == s.charAt(i) && '[' == stack.peek()) {
                    stack.pop();
                }else {
                    stack.push(s.charAt(i));
                }
            }
        }

        if(stack.isEmpty()){
            return true;
        }
        return false;
    }
}
