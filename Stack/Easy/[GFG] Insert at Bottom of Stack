class Solution {
    public Stack<Integer> insertAtBottom(Stack<Integer> st, int x) {
        // code here
        if(st.size() == 0) {
            st.push(x);
            return st;
        }
        
        var top = st.peek();
        st.pop();
        insertAtBottom(st, x);
        st.push(top);
        return st;
    }
}
